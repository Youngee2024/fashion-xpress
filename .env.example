# Server-only Supabase project REST URL. Example: https://your-project.supabase.co
SUPABASE_URL=

# Server-only elevated Supabase service-role/secret key. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Resend API key for transactional email and contact management.
RESEND_API_KEY=

# Verified Resend sender identity. Example: FashionXpress <updates@your-domain.example>
EMAIL_FROM=

# Private recipient for contact and creator-application notifications.
EMAIL_ADMIN_TO=

# Canonical public origin used to build confirmation links. No trailing path.
PUBLIC_APP_URL=

# Server-only random secret of at least 32 characters for HMAC hashing.
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
FORM_SECURITY_SECRET=

# Public presentation mode. Use live only when the Phase 3 backend is configured.
VITE_APP_MODE=demo
